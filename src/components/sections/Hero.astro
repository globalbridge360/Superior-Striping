---
import { getImage } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Button from '../Button.astro';
import Media from '../Media.astro';
import { images } from '../../data/images';
import { site, cta, platforms } from '../../data/site';
import medal from '../../assets/img/award-gold.png';

// Póster: lo que se ve mientras carga el video, sin conexión, con ahorro de datos o con movimiento reducido
const googleProfile = platforms.find((p) => p.name === 'Google')!.href;
const ratingPct = Math.round((site.rating.value / 5) * 100);
// Adelanto del reconocimiento de Business Rate; el detalle está en la sección Recognition
const awardImage = {
  src: medal,
  alt: 'Gold medal with a trophy and #1',
  description: 'Superior Striping was named the #1 asphalt and sealcoating contractor in Nampa by Business Rate.',
};
const poster = await getImage({ src: images.heroPoster.src, width: 1600, format: 'webp', quality: 72 });
---

<section data-hero class="relative isolate flex min-h-[calc(100dvh-var(--strip-h))] overflow-hidden bg-asphalt text-paper">
  <div class="absolute inset-0 -z-20" data-hero-media>
    <video
      class="h-full w-full object-cover"
      autoplay
      muted
      loop
      playsinline
      disablepictureinpicture
      disableremoteplayback
      preload="metadata"
      poster={poster.src}
      aria-describedby="hero-video-desc"
      data-hero-video
    >
      <source src="/media/superior-striping-hero-720.mp4" type="video/mp4" media="(max-width: 767px)" />
      <source src="/media/superior-striping-hero-1080.mp4" type="video/mp4" />
    </video>
    <p id="hero-video-desc" class="sr-only">
      Video of the Superior Striping crew at work: loading asphalt, paving and rolling a new lot, sealing cracks, and painting stall lines, arrows and ADA symbols.
    </p>
  </div>
  <div
    class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgb(17_24_29/0.55)_0%,rgb(17_24_29/0.15)_35%,rgb(17_24_29/0.35)_60%,rgb(17_24_29/0.92)_100%)]"
    aria-hidden="true"
  >
  </div>

  <div class="site-container flex min-h-[calc(100dvh-var(--strip-h))] flex-col justify-between gap-8 pb-8 pt-24 md:pb-12 md:pt-28">
    <div class="flex flex-col gap-6">
      <p class="max-w-[22rem] text-[1.05rem] leading-snug text-paper/85" data-hero-fade>
        Sealcoating, striping and asphalt repair for parking lots and driveways across Nampa, Boise and Meridian.
      </p>

      <!-- Calificación de Google: anillo al 98 % (4.9 de 5), nota grande y frase de confianza -->
      <a
        href={googleProfile}
        target="_blank"
        rel="noopener"
        class="hero-rating group flex items-center gap-4 self-start md:gap-5"
        data-hero-fade
      >
        <span class="relative grid h-12 w-12 shrink-0 place-items-center md:h-14 md:w-14" aria-hidden="true">
          <svg viewBox="0 0 48 48" class="absolute inset-0 h-full w-full -rotate-90">
            <circle cx="24" cy="24" r="21" fill="none" stroke="currentColor" stroke-width="3.5" class="text-paper/20" />
            <circle cx="24" cy="24" r="21" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" pathLength="100" stroke-dasharray={`${ratingPct} 100`} class="hero-rating__ring text-orange" />
          </svg>
          <Icon name="ph:star-fill" size={22} class="text-orange" />
        </span>
        <span class="font-display text-[2rem] font-medium leading-none tracking-[-0.02em] md:text-[2.6rem]">{site.rating.value}/5</span>
        <span class="h-10 w-px bg-paper/30 md:h-12" aria-hidden="true"></span>
        <span class="max-w-[15rem] text-[0.95rem] leading-snug text-paper/90 md:text-base">
          <span class="hidden md:block">Trusted by owners and managers across the valley</span>
          <span class="flex items-center gap-1.5 text-sm text-paper/85 md:mt-1 md:text-paper/70">
            <Icon name="logos:google-icon" size={13} aria-hidden="true" />
            {site.rating.count} Google reviews
          </span>
        </span>
        <span class="sr-only">(opens our Google reviews in a new tab)</span>
      </a>

      <!-- Reconocimiento en móvil y tablet: en escritorio va como tarjeta junto a la de garantía -->
      <a
        href="#award-title"
        class="flex items-center gap-3 self-start rounded-full border border-paper/20 bg-paper/12 py-1.5 pl-1.5 pr-5 backdrop-blur-md lg:hidden"
        data-hero-fade
      >
        <Media image={awardImage} class="h-9 w-9 shrink-0" imgClass="!object-contain" sizes="36px" widths={[72, 112]} fallbackFormat="png" />
        <span class="leading-tight">
          <span class="block text-[0.95rem] font-semibold">#1 rated contractor in Nampa</span>
          <span class="block text-[0.8rem] text-paper/75">Awarded by Business Rate</span>
        </span>
      </a>
    </div>

    <div class="grid items-end gap-10 lg:grid-cols-[1fr_auto]">
      <div>
        <h1 class="h-display max-w-[19ch]" data-hero-title data-split>
          Asphalt sealcoating &amp; parking lot striping
          <span class="mt-3 block text-[0.4em] font-semibold [font-stretch:100%] tracking-normal text-paper/85">
            in Nampa and the Treasure Valley, Idaho
          </span>
        </h1>
        <span class="mt-7 block h-[7px] w-[min(34rem,78%)] origin-left rounded-[1px] bg-orange" data-hero-stripe aria-hidden="true"></span>
        <div class="mt-9 flex flex-wrap items-center gap-5" data-hero-fade>
          <Button href={cta.href} label={cta.label} />
          <a href={site.phoneHref} class="inline-flex min-h-11 items-center gap-2 font-semibold text-paper">
            <Icon name="ph:phone-fill" size={18} aria-hidden="true" />
            {site.phone}
          </a>
        </div>
      </div>

      <div class="hidden w-[20rem] flex-col gap-3 lg:flex">
      <a
        href="#award-title"
        class="group flex items-center gap-4 rounded-[var(--radius-card)] border border-paper/20 bg-paper/12 p-4 backdrop-blur-md transition-colors hover:bg-paper/18"
        data-hero-card
      >
        <Media
          image={awardImage}
          class="h-14 w-14 shrink-0"
          imgClass="!object-contain"
          sizes="56px"
          widths={[112, 168]}
          fallbackFormat="png"
        />
        <span class="min-w-0 flex-1">
          <span class="block text-lg font-semibold leading-tight">#1 rated contractor</span>
          <span class="mt-1 block text-sm leading-snug text-paper/75">In Nampa, awarded by Business Rate</span>
        </span>
        <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-paper/25 text-paper transition-transform duration-500 group-hover:translate-y-0.5">
          <Icon name="ph:arrow-down-bold" size={14} aria-hidden="true" />
        </span>
      </a>
      <a
        href="/about-us/"
        class="group block rounded-[var(--radius-card)] border border-paper/20 bg-paper/12 p-4 backdrop-blur-md transition-colors hover:bg-paper/18"
        data-hero-card
      >
        <div class="flex gap-4">
          <Media
            image={images.lotRestriped}
            class="h-24 w-20 shrink-0 rounded-xl"
            sizes="80px"
            widths={[160]}
          />
          <div>
            <p class="text-lg font-semibold leading-tight">2-year written warranty</p>
            <p class="mt-1 text-sm leading-snug text-paper/75">Two coats of commercial-grade sealer on every job, backed in writing.</p>
          </div>
        </div>
        <span class="mt-4 flex items-center justify-between border-t border-paper/15 pt-3 text-sm font-semibold">
          Why owners choose us
          <span class="grid h-8 w-8 place-items-center rounded-full bg-orange text-asphalt transition-transform duration-500 group-hover:-rotate-45">
            <Icon name="ph:arrow-right-bold" size={14} aria-hidden="true" />
          </span>
        </span>
      </a>
      </div>
    </div>
  </div>
</section>

<script>
  // El póster queda fijo (sin descargar el video) con movimiento reducido, ahorro de datos o conexión 2G.
  // Si el navegador bloquea el autoplay o el video falla, también queda el póster.
  const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
  const lowData = !!conn && (conn.saveData === true || /(^|-)2g$/.test(conn.effectiveType ?? ''));
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLVideoElement>('[data-hero-video]').forEach((v) => {
    if (reduce || lowData) {
      v.removeAttribute('autoplay');
      v.pause();
      if (lowData) {
        v.querySelectorAll('source').forEach((s) => s.remove());
        v.preload = 'none';
        v.load();
      }
      return;
    }
    v.muted = true;
    const p = v.play();
    if (p) p.catch(() => {});
  });
</script>

<style>
  /* El anillo se dibuja al cargar, de 0 al 98 % */
  .hero-rating__ring {
    animation: rating-ring 1.6s var(--ease-out-expo) 1.2s both;
  }
  @keyframes rating-ring {
    from {
      stroke-dasharray: 0 100;
    }
  }
</style>
