---
// Presupuesto al estilo JP&E: tarjeta con foto y datos de contacto a la izquierda y el
// formulario de una pregunta a la vez a la derecha, con una ilustración en la esquina.
import { Icon } from 'astro-icon/components';
import Badge from '../Badge.astro';
import Media from '../Media.astro';
import EstimateForm from '../EstimateForm.astro';
import { images } from '../../data/images';
import { illustrations } from '../../data/illustrations';
import { site } from '../../data/site';

interface Props {
  headingLevel?: 'h1' | 'h2';
}
const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;

// Reseña real de Google (la misma que aparece en Testimonials)
const featured = {
  name: 'Tyler Stapleton',
  initials: 'TS',
  quote:
    'Scott came out and took care of our business. Definitely impressed by his work. They went above and beyond our expectations to meet our actual needs.',
};
---

<section id="estimate" class="section-y bg-concrete scroll-mt-24" aria-labelledby="estimate-title">
  <div class="site-container">
    <div class="flex flex-col items-center text-center">
      <Badge>Free estimate</Badge>
      <Heading id="estimate-title" class:list={[headingLevel === 'h1' ? 'h-display' : 'h-section', 'mt-6 max-w-[16ch]']} data-split>
        Get your free estimate
      </Heading>
      <p class="lead mt-5 max-w-[36rem] text-ink-soft" data-reveal>
        Answer a few quick questions and we'll call you back to set a time to walk the lot. The estimate is free and you don't have to commit to anything.
      </p>
    </div>

    <div class="relative mt-14 grid gap-6 rounded-[1.75rem] border border-line bg-paper p-3 md:p-4 lg:mt-16 lg:grid-cols-[0.9fr_1.1fr] lg:gap-10" data-reveal>
      <div class="flex flex-col gap-6 lg:pb-4">
        <div class="relative isolate flex min-h-[34rem] flex-1 flex-col justify-end overflow-hidden rounded-[1.4rem] p-4 md:p-5">
          <Media
            image={images.contactStriping}
            imgClass="object-[center_15%]"
            class="absolute inset-0 -z-10"
            sizes="(min-width: 1024px) 40vw, 100vw"
            widths={[480, 800, 1100, 1600]}
          />
          <div class="absolute inset-0 -z-10 bg-gradient-to-b from-transparent from-50% to-asphalt/60" aria-hidden="true"></div>
          <!-- Una reseña real de Google como último empujón antes del formulario -->
          <figure class="max-w-[30rem] rounded-[1.1rem] bg-paper/95 p-5 text-ink shadow-[0_12px_32px_-12px_rgb(17_24_29/0.45)] backdrop-blur md:p-6">
            <div class="flex items-center justify-between gap-4">
              <span class="flex gap-0.5 text-orange" role="img" aria-label="Rated 5 out of 5">
                {Array.from({ length: 5 }).map(() => <Icon name="ph:star-fill" size={18} aria-hidden="true" />)}
              </span>
              <Icon name="logos:google-icon" size={20} aria-hidden="true" />
            </div>
            <blockquote class="mt-4 font-display text-[1.2rem] font-medium leading-[1.3] md:text-[1.35rem]">
              <p>&ldquo;{featured.quote}&rdquo;</p>
            </blockquote>
            <figcaption class="mt-5 flex items-center gap-3 text-sm">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-ink text-xs font-bold text-paper" aria-hidden="true">{featured.initials}</span>
              <span class="leading-tight">
                <span class="block font-semibold">{featured.name}</span>
                <span class="text-ink-muted">Google review, {site.rating.value} from {site.rating.count} reviews</span>
              </span>
            </figcaption>
          </figure>
        </div>
        <div class="px-2 md:px-3">
          <p class="font-display text-[1.4rem] font-medium">Rather talk it through?</p>
          <ul class="mt-4 grid gap-5 sm:grid-cols-2">
            <li class="flex items-center gap-3">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-orange text-asphalt"><Icon name="ph:phone-fill" size={20} aria-hidden="true" /></span>
              <span class="leading-tight"><span class="block text-sm text-ink-muted">Call or text</span><a class="inline-flex min-h-10 items-center font-semibold" href={site.phoneHref}>{site.phone}</a></span>
            </li>
            <li class="flex items-center gap-3">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-orange text-asphalt"><Icon name="ph:clock-fill" size={20} aria-hidden="true" /></span>
              <span class="leading-tight"><span class="block text-sm text-ink-muted">Mon to Fri, 8 am to 8 pm</span><span class="font-semibold">Sat, 8 am to noon</span></span>
            </li>
            <li class="flex items-center gap-3 sm:col-span-2">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-orange text-asphalt"><Icon name="ph:map-pin-fill" size={20} aria-hidden="true" /></span>
              <span class="leading-tight"><span class="block text-sm text-ink-muted">Based in</span><span class="font-semibold">Nampa, Idaho, serving the Treasure Valley</span></span>
            </li>
          </ul>
        </div>
      </div>

      <div class="relative px-2 pb-6 pt-4 md:px-4 lg:py-8 lg:pr-10">
        <Media
          image={illustrations.cone}
          class="pointer-events-none absolute -right-4 -top-16 hidden h-32 w-32 rotate-[8deg] md:block lg:-right-8 lg:-top-20 lg:h-40 lg:w-40"
          imgClass="!object-contain"
          sizes="160px"
          widths={[320]}
          fallbackFormat="png"
        />
        <p class="max-w-[24rem] font-display text-[2rem] font-medium leading-[1.05] md:text-[2.4rem]">Tell us about your lot</p>
        <p class="mt-3 max-w-[28rem] text-ink-soft">One quick question at a time, about 60 seconds. We call back Monday to Friday, 8 am to 8 pm.</p>
        <div class="mt-8"><EstimateForm /></div>
      </div>
    </div>
  </div>
</section>
