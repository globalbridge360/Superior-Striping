---
import Pattern from '../Pattern.astro';
import Badge from '../Badge.astro';
import { Icon } from 'astro-icon/components';
import { homeFaq } from '../../data/faq-home';

interface Props {
  items?: readonly { q: string; a: string }[];
  title?: string;
  intro?: string;
  link?: { label: string; href: string } | null;
}
const {
  items = homeFaq,
  title = 'Questions property managers ask us',
  intro = 'Straight answers on timing, cure times and what your lot actually needs.',
  link = { label: 'See all sealcoating and striping questions', href: '/faq/' },
} = Astro.props;
---

<section class="section-y relative isolate" aria-labelledby="faq-title">
  <Pattern kind="asphalt" fade="top-left" />
  <div class="site-container grid gap-12 lg:grid-cols-[1fr_1.5fr] lg:gap-16">
    <div class="lg:sticky lg:top-32 lg:self-start">
      <Badge>FAQ</Badge>
      <h2 id="faq-title" class="h-section mt-5 max-w-[12ch]" data-split>{title}</h2>
      <p class="mt-6 max-w-sm text-lg text-ink-soft" data-reveal>
        {intro}
      </p>
      {link && <a href={link.href} class="link-arrow mt-8" data-reveal>{link.label}</a>}
    </div>

    <div data-faq class="divide-y divide-line border-y border-line">
      {
        items.map((f) => (
          <details class="faq-item group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-left text-lg font-semibold md:text-xl">
              <span>{f.q}</span>
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-paper text-orange transition-transform duration-500 group-open:rotate-45">
                <Icon name="ph:plus-bold" size={16} aria-hidden="true" />
              </span>
            </summary>
            <div data-faq-body class="overflow-hidden">
              <p class="max-w-[60ch] pb-7 text-ink-soft">{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
</style>
